# --- Agent ------------------------------------------------------------------
AGENT_EORI=

# Account 1 is the default account for normal single-worker runs.
# Accounts 2–15 are used only when the run uses more workers; CI runs 3 shards x 5
# workers, which takes accounts 1–15.
#
# Accounts must be numbered contiguously from 1. The loader stops at the first
# missing AGENT_USER_NAME_<n>.
#
# All Agent accounts currently share AGENT_PASSWORD, but each account must have
# its own TOTP secret.
AGENT_PASSWORD=

AGENT_USER_NAME_1=
AGENT_TOTP_SECRET_1=

AGENT_USER_NAME_2=
AGENT_TOTP_SECRET_2=

