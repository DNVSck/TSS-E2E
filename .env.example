# --- Primary account holder -------------------------------------------------
# Primary account holder - the user the authority/permission tests sign in as. A
# separate company from the journey accounts on purpose: those tests probe what is
# REFUSED, so they must not be able to disturb the accounts the journey suite needs.
PRIMARY_HOLDER_USER_NAME=
PRIMARY_HOLDER_PASSWORD=
PRIMARY_HOLDER_TOTP_SECRET=
PRIMARY_HOLDER_EORI=

# --- Non-primary account holder ---------------------------------------------
# The SAME company as the primary holder above, but not the account holder - the pair
# is what makes a permission test meaningful: same data, different rights, so a refused
# action can only be explained by the role.
NON_PRIMARY_HOLDER_USER_NAME=
NON_PRIMARY_HOLDER_PASSWORD=
NON_PRIMARY_HOLDER_TOTP_SECRET=

# --- Auth suite account pool ------------------------------------------------
# The pool the auth suite signs in as - one account per parallel worker.
#
# Not the holder accounts above: those two exist to differ in RIGHTS, and only the
# permissions spec cares. Every other auth test just needs somewhere to sign in, and
# several of them sign in WRONG on purpose - so they must not all spend the failed
# attempts of one account, which the identity provider locks after ten.
#
# Add as many as you want workers. Each needs its OWN authenticator secret: two
# accounts sharing one generate the same code, which is the contention a pool exists
# to remove. PASSWORD may be shared (drop the _n) when the accounts share one.
#
# QUOTE any password containing # - dotenv reads an unquoted # as the start of a
# comment and silently keeps only what precedes it, so the password arrives
# truncated and the account looks like it has the wrong password. Single quotes
# also stop $ being read as a variable.
AUTH_ACCOUNT_PASSWORD=

AUTH_ACCOUNT_USER_NAME_1=
AUTH_ACCOUNT_TOTP_SECRET_1=

AUTH_ACCOUNT_USER_NAME_2=
AUTH_ACCOUNT_TOTP_SECRET_2=

AUTH_ACCOUNT_USER_NAME_3=
AUTH_ACCOUNT_TOTP_SECRET_3=

AUTH_ACCOUNT_USER_NAME_4=
AUTH_ACCOUNT_TOTP_SECRET_4=

AUTH_ACCOUNT_USER_NAME_5=
AUTH_ACCOUNT_TOTP_SECRET_5=

AUTH_ACCOUNT_USER_NAME_6=
AUTH_ACCOUNT_TOTP_SECRET_6=

AUTH_ACCOUNT_USER_NAME_7=
AUTH_ACCOUNT_TOTP_SECRET_7=

AUTH_ACCOUNT_USER_NAME_8=
AUTH_ACCOUNT_TOTP_SECRET_8=

AUTH_ACCOUNT_USER_NAME_9=
AUTH_ACCOUNT_TOTP_SECRET_9=

AUTH_ACCOUNT_USER_NAME_10=
AUTH_ACCOUNT_TOTP_SECRET_10=

AUTH_ACCOUNT_USER_NAME_11=
AUTH_ACCOUNT_TOTP_SECRET_11=

AUTH_ACCOUNT_USER_NAME_12=
AUTH_ACCOUNT_TOTP_SECRET_12=

AUTH_ACCOUNT_USER_NAME_13=
AUTH_ACCOUNT_TOTP_SECRET_13=

AUTH_ACCOUNT_USER_NAME_14=
AUTH_ACCOUNT_TOTP_SECRET_14=

AUTH_ACCOUNT_USER_NAME_15=
AUTH_ACCOUNT_TOTP_SECRET_15=

# --- Carrier ----------------------------------------------------------------
CARRIER_USER_NAME=
CARRIER_PASSWORD=
CARRIER_TOTP_SECRET=
CARRIER_EORI=

# --- Case management admin --------------------------------------------------
# Case management admin — the account that can run a batch job on demand
# (ENS/EIDR arrival transition). Leave blank where the app is not reachable; a job
# trigger then fails naming these keys instead of silently doing nothing.
CASE_MANAGEMENT_USER_NAME=
CASE_MANAGEMENT_PASSWORD=


##############################################################################
# COUNTERPARTIES
##############################################################################

# Counterparties a declaration names. Not accounts - nothing signs in as these, they
# are only entered on a party screen, so all each has to be is an EORI that exists in
# TSS. One company may cover every role; they are separate keys so a role can move to
# its own company without touching a single test.
BUYER_EORI=
CONSIGNOR_EORI=
CONSIGNEE_EORI=
SELLER_EORI=
EXPORTER_EORI=


##############################################################################
# EXTERNAL SERVICES
##############################################################################

# --- Trader API -------------------------------------------------------------
TRADER_API_CLIENT_ID=
TRADER_API_CLIENT_SECRET=

# --- CDS --------------------------------------------------------------------
CDS_TOKEN=
CDS_TDR=

# --- GVMS -------------------------------------------------------------------
GVMS_PUSH_SECRET=

# --- ICS2 -------------------------------------------------------------------
# Declarant the ICS2 notification messages are published under (see api-helper).
ICS2_DECLARANT_ID=
ISC2_MOCK_SERVER=

# RabbitMQ management API — used to publish ICS2 test messages (SIT only).
RMQ_HOST=
RMQ_USERNAME=
RMQ_PWD=

# --- HMRC API (FFD arrival) -------------------------------------------------
HMRC_API_URL=
HMRC_AUTHORIZE_URL=
HMRC_CLIENT_ID=
HMRC_CLIENT_SECRET=
HMRC_REDIRECT_URI=
HMRC_SCOPE=
HMRC_TEST_USER_ID=
HMRC_TEST_USER_PASSWORD=


##############################################################################
# RUN CONFIGURATION
##############################################################################

# --- Sign-in ----------------------------------------------------------------
OTP_ENABLED=true

# --- Timeouts ---------------------------------------------------------------
TEST_BASE_TIMEOUT= 300000       # timeout for each test, default: 30s
GLOBAL_TIMEOUT= 0               # maximum timeout for whole test suite, default: 0s (disabled)
EXPECT_BASE_TIMEOUT= 30000      # timeout for expect matchers, default: 5s
PAGE_TIMEOUT= 30000
DEFAULT_TIMEOUT=60000          # actionTimeout + navigationTimeout in playwright.config.ts

# --- Browser ----------------------------------------------------------------
HEADLESS=false                 # Run browser in headless mode
SLOW_MO=0                      # Slow down operations by N milliseconds
BROWSER=chromium               # Browser to use: chromium, firefox, webkit

# --- Test run ---------------------------------------------------------------
RETRY_COUNT=0               # Number of retries for failed tests
WORKERS=1                     # Number of parallel workers
SCREENSHOT_MODE=only-on-failure # Screenshot mode: always, never, only-on-failure
VIDEO_MODE=retain-on-failure   # Video mode: always, never, retain-on-failure
