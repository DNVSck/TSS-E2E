BASE_URL=https://{ENV}.nc-tss.uk/portal/

# Agent account pool
#
# Account 1 is the default account for normal single-worker runs.
# Accounts 2–4 are used only when the run uses 2–4 parallel workers.
#
# Accounts must be numbered contiguously from 1. The loader stops at the first
# missing AGENT_USER_NAME_<n>.
#
# All Agent accounts currently share AGENT_PASSWORD, but each account must have
# its own TOTP secret.
AGENT_PASSWORD=

AGENT_USER_NAME_1=
AGENT_TOTP_SECRET_1=

AGENT_USER_NAME_2=
AGENT_TOTP_SECRET_2=

AGENT_USER_NAME_3=
AGENT_TOTP_SECRET_3=

AGENT_USER_NAME_4=
AGENT_TOTP_SECRET_4=

# Haulier Company User Credentials
HAULIER_USER_NAME=
HAULIER_EORI=
HAULIER_PASSWORD=
HAULIER_TOTP_SECRET=
# Company the Agent starts representing to run a Haulier journey. Environment
# data (differs per env, like the EORIs above), matched on the visible name.
HAULIER_COMPANY_NAME=

# Importer Company User Credentials
IMPORTER_USER_NAME=
IMPORTER_EORI=
IMPORTER_PASSWORD=
IMPORTER_TOTP_SECRET=
# Company the Agent starts representing to run an Importer journey.
IMPORTER_COMPANY_NAME=

# RabbitMQ management API — used to publish ICS2 test messages (SIT only).
RMQ_HOST=
RMQ_USERNAME=
RMQ_PWD=


# Carrier Company User Credentials
CARRIER_USER_NAME=
CARRIER_EORI=
CARRIER_PASSWORD=
CARRIER_TOTP_SECRET=

# TOTP
OTP_ENABLED=true

# Timeout
TEST_BASE_TIMEOUT= 300000       # timeout for each test, default: 30s
GLOBAL_TIMEOUT= 0               # maximum timeout for whole test suite, default: 0s (disabled)
EXPECT_BASE_TIMEOUT= 30000      # timeout for expect matchers, default: 5s
PAGE_TIMEOUT= 30000
DEFAULT_TIMEOUT= 15000         # timeout for all function in page

# Browser Configuration
HEADLESS=false                 # Run browser in headless mode
SLOW_MO=0                      # Slow down operations by N milliseconds
BROWSER=chromium               # Browser to use: chromium, firefox, webkit

# Test Configuration
RETRY_COUNT=0               # Number of retries for failed tests
WORKERS=1                     # Number of parallel workers
SCREENSHOT_MODE=only-on-failure # Screenshot mode: always, never, only-on-failure
VIDEO_MODE=retain-on-failure   # Video mode: always, never, retain-on-failure

# View port
MAX_HEIGHT = 1920;
MAX_WIDTH = 1080;

# OpenAI API Configuration (for AI Chatbot Evaluation)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=


LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=

HUGGINGFACE_API_KEY=
