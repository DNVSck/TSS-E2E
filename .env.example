BASE_URL=https://nc-tss.uk/portal/

# Credentials per role. Convention: <ROLE>_<FIELD>.
# TOTP_SECRET is optional - when set, the sign-in flow completes the OTP step
# automatically with that account's own secret.
AGENT_USER_NAME=
AGENT_PASSWORD=
AGENT_TOTP_SECRET=
AGENT_EORI=

IMPORTER_USER_NAME=
IMPORTER_PASSWORD=
IMPORTER_TOTP_SECRET=
IMPORTER_EORI=

HAULIER_USER_NAME=
HAULIER_PASSWORD=
HAULIER_TOTP_SECRET=
HAULIER_EORI=

# Test-data EORIs (movement declaration). HAULIER_EORI above is reused for the
# movement's haulier. Optional - fall back to built-in defaults when unset.
CARRIER_EORI=

LOCALE=en                  # Locale: all | en | cy

# Timeout
TEST_BASE_TIMEOUT= 60000       # timeout for each test, default: 30s
GLOBAL_TIMEOUT= 0               # maximum timeout for whole test suite, default: 0s (disabled)
EXPECT_BASE_TIMEOUT= 30000      # timeout for expect matchers, default: 5s
PAGE_TIMEOUT= 30000
DEFAULT_TIMEOUT= 5000          # timeout for all function in page

# Browser Configuration
HEADLESS=false                 # Run browser in headless mode
SLOW_MO=0                      # Slow down operations by N milliseconds
BROWSER=chromium               # Browser to use: chromium, firefox, webkit

# Test Configuration
RETRY_COUNT=0                  # Number of retries for failed tests
WORKERS=1                      # Number of parallel workers
SCREENSHOT_MODE=only-on-failure # Screenshot mode: always, never, only-on-failure
VIDEO_MODE=retain-on-failure   # Video mode: always, never, retain-on-failure

# View port
MAX_HEIGHT = 1920;
MAX_WIDTH = 1080;