{
  "name": "TSS-E2E",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean": "powershell -Command \"if (Test-Path test-results) { Remove-Item -Recurse -Force test-results }; New-Item -ItemType Directory -Force -Path test-results\"",
    "test": "playwright test",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "pnpm test && pnpm report:open",
    "test:ui:poc:cy": "powershell -Command \"$env:ENV='poc'; $env:LOCALE='cy'; playwright test tests/ui --project=chromium-cy\"",
    "test:ui:poc:en": "powershell -Command \"$env:ENV='poc'; $env:LOCALE='en'; playwright test tests/ui --project=chromium-en\"",
    "report:open": "powershell -Command \"Start-Process 'test-results/result.html'\"",
    "report:serve": "npx allure serve allure-results",
    "report:manual": "node -e \"require('./global-teardown.js').default()\"",
    "lint": "eslint . --ext .ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.24.0",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@faker-js/faker": "^10.1.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "allure-commandline": "^2.34.1",
    "allure-js-commons": "^3.4.3",
    "allure-playwright": "^3.4.3",
    "axe-core": "^4.11.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.4.0"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "puppeteer": "^24.42.0"
  }
}