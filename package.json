{
  "name": "TSS-E2E",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean": "powershell -Command \"if (Test-Path test-results) { Remove-Item -Recurse -Force test-results }; New-Item -ItemType Directory -Force -Path test-results\"",
    "test": "playwright test",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "pnpm test && pnpm report:open",
    "test:poc": "powershell -Command \"$env:ENV='poc'; playwright test\"",
    "test:staging": "powershell -Command \"$env:ENV='staging'; playwright test\"",
    "test:production": "powershell -Command \"$env:ENV='production'; playwright test\"",
    "test:qa": "powershell -Command \"$env:ENV='qa'; playwright test\"",
    "test:uat": "powershell -Command \"$env:ENV='uat'; playwright test\"",
    "test:poc:headed": "powershell -Command \"$env:ENV='poc'; playwright test --headed\"",
    "test:staging:headed": "powershell -Command \"$env:ENV='staging'; playwright test --headed\"",
    "test:uat:headed": "powershell -Command \"$env:ENV='uat'; playwright test --headed\"",
    "test:production:headed": "powershell -Command \"$env:ENV='production'; playwright test --headed\"",
    "test:ui-demo": "pnpm test tests/ui/gb-ni-roro-simple-acco.spec.ts --headed",
    "test:accessibility-demo": "pnpm test tests/accessibility/accessibility-portalpage.spec.ts",
    "test:ai-happy": "playwright test tests/ai_chatbot/ai-chatbot-huggingface-embedding-demo.spec.ts --grep @happy --headed",
    "test:ai-unhappy": "playwright test tests/ai_chatbot/ai-chatbot-huggingface-embedding-demo.spec.ts --grep @unhappy --headed",
    "test:ai-all": "playwright test tests/ai_chatbot/ai-chatbot-huggingface-embedding-demo.spec.ts --headed",
    "report:generate": "npx allure generate allure-results -o test-results --clean && move test-results\\index.html test-results\\result.html",
    "report:open": "powershell -Command \"Start-Process 'test-results/result.html'\"",
    "report:serve": "npx allure serve allure-results",
    "report:manual": "node -e \"require('./global-teardown.js').default()\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.24.0",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@faker-js/faker": "^10.1.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "allure-commandline": "^2.34.1",
    "allure-js-commons": "^3.4.3",
    "allure-playwright": "^3.4.3",
    "axe-core": "^4.11.0"
  },
  "dependencies": {
    "@huggingface/inference": "^4.13.10",
    "dotenv": "^17.2.3",
    "langfuse": "^3.38.6",
    "openai": "^6.16.0"
  }
}
