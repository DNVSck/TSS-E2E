{
  "name": "TSS-E2E",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean": "powershell -Command \"if (Test-Path test-results) { Remove-Item -Recurse -Force test-results }; New-Item -ItemType Directory -Force -Path test-results\"",
    "test": "playwright test",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "pnpm test && pnpm report:open",
    "test:smoke:sit": "cross-env ENV=sit playwright test --grep '@smoke' --workers=4 --project=chromium-en",
    "test:smoke:test": "cross-env ENV=test playwright test --grep '@smoke' --workers=4 --project=chromium-en",
    "test:functional:sit": "cross-env ENV=sit playwright test tests/functional --workers=4 --project=chromium-en",
    "test:functional:test": "cross-env ENV=test playwright test tests/functional --workers=4 --project=chromium-en",
    "test:standalone:sit": "cross-env ENV=sit playwright test tests/functional/standalone --workers=4 --project=chromium-en",
    "test:standalone:test": "cross-env ENV=test playwright test tests/functional/standalone --workers=4 --project=chromium-en",
    "test:ens:sit": "cross-env ENV=sit playwright test tests/functional/ens-integrated --workers=4 --project=chromium-en",
    "test:ens:test": "cross-env ENV=test playwright test tests/functional/ens-integrated --workers=4 --project=chromium-en",
    "report:open": "allure open allure-report",
    "report:serve": "allure open allure-results",
    "report:pdf": "tsx --tsconfig tsconfig.json src/core/report/export-allure-pdf.mts",
    "lint": "eslint . --ext .ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.24.0",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@faker-js/faker": "^10.1.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "allure": "^3.14.3",
    "allure-js-commons": "^3.4.3",
    "allure-playwright": "^3.4.3",
    "axe-core": "^4.11.0",
    "cross-env": "10.1.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.4.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "otpauth": "^9.5.1",
    "puppeteer": "^24.42.0"
  }
}