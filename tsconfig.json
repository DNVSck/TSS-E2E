{
    "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "config/**/*.ts",
    "playwright.config.ts"
  ],
    "exclude": [
        "node_modules",
        "dist",
        "allure-results",
        "allure-report",
        "output"
    ]
}